PORT=3002

# Base de datos exclusiva del microservicio Reservations
MONGO_URI=mongodb://127.0.0.1:27017/reservations_db

# Debe coincidir con el JWT_SECRET de auth-service: los tokens los emite Auth,
# Reservations solo los verifica.
JWT_SECRET=hotel_auth_secret_change_me

# RabbitMQ local (mismo exchange que el resto de microservicios)
RABBITMQ_URL=amqp://127.0.0.1:5672
RABBITMQ_EXCHANGE=hotel_events

# Necesario para el consumo de productos durante una estadía (quick-checkin
# + POST /:id/consumptions): reservations-service llama a products-service
# para consultar el precio y descontar stock.
PRODUCTS_SERVICE_URL=http://localhost:3003
