PORT=3005

# Base de datos exclusiva del microservicio Stays
MONGO_URI=mongodb://127.0.0.1:27017/stays_db

# Debe coincidir con el JWT_SECRET de auth-service.
JWT_SECRET=hotel_auth_secret_change_me

RABBITMQ_URL=amqp://127.0.0.1:5672
RABBITMQ_EXCHANGE=hotel_events

# Servicios a los que Stays llama por HTTP reenviando el token del usuario
ROOMS_SERVICE_URL=http://localhost:3001
PRODUCTS_SERVICE_URL=http://localhost:3003
