PORT=3003

# Base de datos exclusiva del microservicio Products
MONGO_URI=mongodb://127.0.0.1:27017/products_db

# Debe coincidir con el JWT_SECRET de auth-service: los tokens los emite Auth,
# Products solo los verifica.
JWT_SECRET=hotel_auth_secret_change_me

# RabbitMQ local (mismo exchange que el resto de microservicios)
RABBITMQ_URL=amqp://127.0.0.1:5672
RABBITMQ_EXCHANGE=hotel_events

# Cuando el stock de un producto baja a este valor (o menos) se publica
# el evento inventory.low_stock
LOW_STOCK_THRESHOLD=5
